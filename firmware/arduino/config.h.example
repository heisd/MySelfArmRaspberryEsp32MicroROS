/**
 * config.h.example — 固件配置模板
 *
 * 使用步骤：
 *   1. 将此文件复制并重命名为 config.h
 *   2. 填入实际的 WiFi 和 ROS Agent 信息
 *   3. config.h 已加入 .gitignore，不会提交到版本库
 */

#ifndef CONFIG_H
#define CONFIG_H

// WiFi 配置
#define WIFI_SSID     "your_wifi_ssid"
#define WIFI_PASSWORD "your_wifi_password"

// micro-ROS Agent 配置
// 运行 Agent 的主机 IP（通常为树莓派 IP）
#define AGENT_IP   "192.168.x.x"
#define AGENT_PORT 8888

// I²C 引脚（根据实际接线修改）
#define I2C_SDA 8
#define I2C_SCL 9

// PCA9685 舵机脉冲范围
#define SERVO_MIN 150   // 对应 0°
#define SERVO_MAX 600   // 对应 180°

#endif // CONFIG_H
